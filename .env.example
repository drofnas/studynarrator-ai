# Host-side Web exposure. Keep the default loopback binding unless you intentionally
# want other devices to reach StudyNarrator.
STUDYNARRATOR_BIND_ADDRESS=127.0.0.1
STUDYNARRATOR_HOST_PORT=8080
STUDYNARRATOR_IMAGE_TAG=0.1.0
STUDYNARRATOR_SOURCE_REVISION=local

# Speaches is a separate application. Inside the StudyNarrator container,
# localhost means this container; use host.docker.internal for Speaches on the
# Docker host, or use a private hostname/IP for Speaches on another machine.
SPEACHES_BASE_URL=http://host.docker.internal:8000
SPEACHES_API_KEY=
SPEACHES_MODEL_ID=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEACHES_DEFAULT_VOICE=af_heart
SPEACHES_REQUEST_TIMEOUT_SECONDS=120
SPEACHES_RETRY_COUNT=2

# Set true when the deployment owner, rather than the browser user, controls the
# active Speaches endpoint.
STUDYNARRATOR_LOCK_SPEACHES_SETTINGS=false
